{
  "name": "@popcomputer/document-graph",
  "version": "0.4.1",
  "description": "Schema-defined document graphs with hybrid search, graph retrieval, and composable storage",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "import": "./dist/d1.js"
    },
    "./d1/schema": {
      "types": "./dist/d1-schema.d.ts",
      "import": "./dist/d1-schema.js"
    },
    "./in-memory": {
      "types": "./dist/in-memory.d.ts",
      "import": "./dist/in-memory.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./turbopuffer": {
      "types": "./dist/turbopuffer.d.ts",
      "import": "./dist/turbopuffer.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "migrations",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.type-tests.json",
    "lint": "oxlint",
    "test": "bun test",
    "test:live:turbopuffer": "RUN_DOCUMENT_GRAPH_TURBOPUFFER_TESTS=true bun test tests/turbopuffer-live.integration.test.ts",
    "test:node": "bun run build && node tests/node-esm-smoke.mjs",
    "test:workers": "vitest run --config vitest.config.workers.ts",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "verify": "bun run lint && bun run check && bun test && bun run test:workers && bun run test:node",
    "prepack": "bun run build",
    "prepublishOnly": "bun run verify"
  },
  "keywords": [
    "effect",
    "graph",
    "popcomputer",
    "semantic-search",
    "vector"
  ],
  "author": "Patrick Ogilvie",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickOgilvie/popcomputer-document-graph.git"
  },
  "homepage": "https://github.com/PatrickOgilvie/popcomputer-document-graph#readme",
  "bugs": {
    "url": "https://github.com/PatrickOgilvie/popcomputer-document-graph/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "@turbopuffer/turbopuffer": "2.8.0",
    "@types/pg": "^8.15.5",
    "drizzle-orm": "0.45.2",
    "pg": "^8.16.3"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.109"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260815.1",
    "@effect/vitest": "4.0.0-rc.109",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "0.31.10",
    "effect": "4.0.0-rc.109",
    "oxlint": "1.78.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.0"
  }
}
